# --- Секреты: никогда не в git ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- WordPress: ядро и медиа не версионируются ---
# Версионируем только свою тему, mu-plugins и декларативный список плагинов.
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/
wp-content/plugins/
!wp-content/plugins/.gitkeep
wp-content/themes/*
!wp-content/themes/zt-*/
wp-config.php

# --- Дампы и бэкапы ---
*.sql
*.sql.gz
backups/

# --- Состояние деплоя на сервере ---
# Кем и когда какой коммит применён: нужно скрипту откката, к коду не относится.
.deploy-history

# --- Локальная разработка ---
node_modules/
vendor/
.DS_Store
*.log

# Настройки IDE: они про машину разработчика, а не про проект.
.idea/
.vscode/

# Временные файлы Claude Code рядом с настройками проекта
.claude/settings.local.json
.claude/*.tmp.*
