# Образец файла окружения. Скопировать в `.env` рядом с этим файлом и заполнить.
# `.env` в git не попадает (см. .gitignore) и на сервере должен иметь права 600.
#
# Все переменные ниже обязательны, если явно не сказано иное: отсутствующее или
# пустое значение останавливает запуск стека с указанием имени переменной.
#
# ВАЖНО про символ `$`: Docker Compose трактует его в значениях как подстановку.
# Поэтому пароли и соли генерируются в base64 — там этого символа нет.
# Готовые значения даёт `scripts/gen-secrets.sh`.


# --- Адрес сайта и TLS -------------------------------------------------------

# Адрес, на котором Caddy обслуживает сайт. Он же определяет режим TLS:
#   example.org           — автоматический сертификат Let's Encrypt на домен
#   https://203.0.113.7   — сертификат на IP-адрес (профиль shortlived, ~6 суток)
#   http://203.0.113.7    — без TLS; в этом режиме админка открывается только
#                           через SSH-туннель, пароль по открытому HTTP не ходит
ZT_SITE_ADDRESS=http://203.0.113.7

# Канонический адрес сайта со схемой. Отсюда берутся WP_HOME и WP_SITEURL —
# в базу данных адрес не записывается, поэтому переход с IP на домен это
# правка этой переменной и перезапуск, а не поиск с заменой по базе.
# Должен соответствовать ZT_SITE_ADDRESS (схема + имя или IP + порт).
ZT_SITE_URL=http://203.0.113.7

# Адрес для Let's Encrypt: туда приходят предупреждения об истечении сертификата.
# В режиме `http://` не используется, но заполнить стоит заранее.
ZT_ACME_EMAIL=you@example.org

# Профиль сертификата Let's Encrypt:
#   shortlived — единственный, которым выдаются сертификаты на IP-адрес; срок
#                около шести суток, продление автоматическое
#   classic    — обычный срок 90 суток; ставить вместе с переходом на домен
# В режиме `http://` значение не используется, но переменная обязательна.
ZT_ACME_PROFILE=shortlived


# --- Пределы размера и памяти ------------------------------------------------

# Предел размера HTTP-запроса. Единый источник для трёх мест: Caddy
# (request_body max_size), PHP (upload_max_filesize и post_max_size) и
# WordPress (фильтр upload_size_limit в mu-plugin).
# Максимальный файл, который увидит редактор, на 8 МБ меньше — это накладные
# расходы multipart-запроса, иначе файл ровно по пределу обрывался бы.
ZT_REQUEST_LIMIT=80M

# Предел памяти PHP. Создание превью для фотографии 40-50 МБ требует
# 300-400 МБ, см. design.md. На тестовой машине с 981 МБ это значение
# на границе возможного и является уступкой тестовой машине.
ZT_PHP_MEMORY_LIMIT=384M


# --- База данных -------------------------------------------------------------

ZT_DB_NAME=zt_web
ZT_DB_USER=zt_web

# Пароль пользователя базы, от которого работает сайт. Значение ниже —
# заведомо нерабочая заглушка, заменить своим.
ZT_DB_PASSWORD=REPLACE_ME_db_password

# Пароль root в базе. Нужен скриптам дампа и восстановления.
ZT_DB_ROOT_PASSWORD=REPLACE_ME_db_root_password


# --- Соли и ключи аутентификации WordPress -----------------------------------
#
# Восемь значений, каждое своё, длиной не меньше 48 символов. Попадают в
# wp-config.php из окружения, в git не версионируются. Замена делает
# недействительными все ранее выданные сессии — процедура в docs/runbook.md.
# Сгенерировать: scripts/gen-secrets.sh

WORDPRESS_AUTH_KEY=REPLACE_ME_auth_key
WORDPRESS_SECURE_AUTH_KEY=REPLACE_ME_secure_auth_key
WORDPRESS_LOGGED_IN_KEY=REPLACE_ME_logged_in_key
WORDPRESS_NONCE_KEY=REPLACE_ME_nonce_key
WORDPRESS_AUTH_SALT=REPLACE_ME_auth_salt
WORDPRESS_SECURE_AUTH_SALT=REPLACE_ME_secure_auth_salt
WORDPRESS_LOGGED_IN_SALT=REPLACE_ME_logged_in_salt
WORDPRESS_NONCE_SALT=REPLACE_ME_nonce_salt


# --- Учётные записи WordPress ------------------------------------------------
#
# Используются только скриптом scripts/wp-provision.sh при первичной настройке
# сайта. Пароли скрипт генерирует сам и печатает один раз.

ZT_SITE_TITLE=Заточные камни

# Администратор — разработчик.
ZT_ADMIN_LOGIN=dev
ZT_ADMIN_EMAIL=dev@example.org

# Редактор — тот, кто пишет статьи. Роль `editor`, доступа к серверу нет.
ZT_EDITOR_LOGIN=editor
ZT_EDITOR_EMAIL=editor@example.org

# Пока сайт живёт на IP и статьи не публикуются, индексация закрыта.
# Снять (0) вместе с переходом на домен.
ZT_DISCOURAGE_INDEXING=1


# --- Резервное копирование базы ----------------------------------------------

# Каталог для локальных копий дампов на сервере. Вне рабочей копии репозитория.
ZT_BACKUP_DIR=/var/backups/zt-web

# Глубина хранения копий, в днях. Применяется и локально, и в B2.
ZT_BACKUP_RETENTION_DAYS=14

# Сколько свободного места на диске требовать перед созданием дампа, в МБ.
# Диск делится с Amnezia и подкачкой, поэтому порог с запасом.
ZT_BACKUP_MIN_FREE_MB=3072

# Ожидаемый интервал между копиями, в часах. Дольше — scripts/backup-check.sh
# сообщает об устаревшей копии. Суточное расписание плюс запас.
ZT_BACKUP_MAX_AGE_HOURS=30

# Backblaze B2: бакет только под дампы БД и ключ с правами только на него.
ZT_B2_BUCKET=REPLACE_ME_bucket_name
ZT_B2_PREFIX=db
ZT_B2_KEY_ID=REPLACE_ME_key_id
ZT_B2_APP_KEY=REPLACE_ME_application_key
