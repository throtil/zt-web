# Расписание бэкапа базы. Устанавливается на сервере копированием:
#
#   sudo install -m 644 -o root -g root deploy/cron/zt-web /etc/cron.d/zt-web
#
# Перед установкой заменить: <логин> на непривилегированного пользователя,
# /srv/zt-web на путь рабочей копии, адрес в MAILTO на свой.
#
# Планировщик — хостовый cron, а не контейнер: контейнер-планировщик это ещё
# один сервис, который должен быть жив и чей сбой надо отдельно замечать.
# Хостовый cron сообщает о неуспешном запуске сам, а его отказ означает отказ
# всей машины, который заметен и так.
#
# MAILTO работает, только если на хосте настроена отправка почты. Если её нет,
# отказ обнаруживается второй строкой — проверкой свежести копии, которая
# завершается ошибкой и попадает в журнал. Она же закрывает случай «сервер был
# выключен в момент планового запуска»: пропущенный запуск обычный cron не
# догоняет, но устаревшая копия будет замечена.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=you@example.org

# Дамп базы: ночью, когда редактор не работает.
30 3 * * * <логин> cd /srv/zt-web && ./scripts/backup-db.sh >>/var/backups/zt-web/backup.log 2>&1

# Проверка свежести последней годной копии: утром, чтобы отказ ночного запуска
# был заметен в тот же день.
15 9 * * * <логин> cd /srv/zt-web && ./scripts/backup-check.sh >>/var/backups/zt-web/backup.log 2>&1
