# Обратный прокси перед WordPress — единственная точка приёма трафика снаружи.
#
# Адрес сайта задаётся переменной ZT_SITE_ADDRESS и он же определяет режим TLS:
#   example.org           — автоматический сертификат Let's Encrypt на домен,
#                           HTTP получает постоянный редирект на HTTPS
#   https://203.0.113.7   — сертификат на IP-адрес; Let's Encrypt выдаёт такие
#                           с 15 января 2026 профилем shortlived, срок ~6 суток
#   http://203.0.113.7    — без TLS; в этом режиме админка открывается только
#                           через SSH-туннель, чтобы пароль не шёл открытым
#
# Смена режима — правка ZT_SITE_ADDRESS и ZT_SITE_URL в `.env` и перезапуск.
# Адрес сайта в базе данных не хранится, миграции данных при этом нет.
{
	email {$ZT_ACME_EMAIL}
	# Административный интерфейс слушает только localhost внутри контейнера
	# и используется проверкой готовности. Наружу он не публикуется.
}

{$ZT_SITE_ADDRESS} {
	encode zstd gzip

	# Профиль сертификата Let's Encrypt. На IP-адрес выдаётся только `shortlived`
	# (срок ~6 суток), на домен берётся `classic` (90 суток) — значение задаётся
	# переменной ZT_ACME_PROFILE, чтобы переход с IP на домен не требовал правки
	# этого файла.
	#
	# Блок оставлен раскрытым во всех режимах намеренно: `caddy validate`
	# принимает его и при `http://<IP>`, где TLS не применяется вовсе. Иначе
	# режим без TLS требовал бы второго Caddyfile, а два файла расходятся.
	tls {
		issuer acme {
			profile {$ZT_ACME_PROFILE}
		}
	}

	# Предел размера тела запроса. То же значение, что у PHP (post_max_size)
	# и у предела загрузки в WordPress — единый источник ZT_REQUEST_LIMIT.
	# Расхождение между тремя местами даёт худший вид отказа: обрыв на
	# середине долгой загрузки без внятного сообщения.
	request_body {
		max_size {$ZT_REQUEST_LIMIT}
	}

	reverse_proxy wordpress:80 {
		# X-Forwarded-Proto и X-Forwarded-Host Caddy передаёт сам.
		# X-Real-IP задаём явно: {client_ip} учитывает список доверенных
		# прокси, поэтому при включении Cloudflare достаточно будет добавить
		# его адреса в trusted_proxies, не меняя разбор на стороне PHP.
		header_up X-Real-IP {client_ip}

		# Загрузка фотографии на 50 МБ — это минуты, а не секунды.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	log {
		output stderr
		format console
	}
}

# Когда появится домен: неканонические имена получают постоянный редирект
# на каноническое. Раскомментировать и перечислить имена (задача 12.5).
# www.example.org, example.net {
# 	redir {$ZT_SITE_URL}{uri} permanent
# }

# Когда включится проксирование Cloudflare: перечислить его адреса как
# доверенные прокси, иначе {client_ip} будет адресом узла CDN (задача 13.3).
# Список адресов: https://www.cloudflare.com/ips/
