# Параметры MariaDB под малую память.
#
# УСТУПКА ТЕСТОВОЙ МАШИНЕ. Значения выбраны не по потребностям базы, а по
# остатку памяти: 981 МБ всего, около 330 МБ занято системой и Amnezia,
# и из остатка PHP нужно 300-400 МБ на создание превью.
# На целевой машине этот файл пересматривается целиком —
# см. docs/test-machine-concessions.md.
#
# По умолчанию MariaDB рассчитывает на машину в разы крупнее и без явных
# значений отказывает под нагрузкой в самый неудобный момент.

[mariadbd]

# Пул буферов InnoDB — главный потребитель. 64 МБ хватает базе из статей
# и настроек WordPress; на целевой машине это первое, что нужно увеличить.
innodb_buffer_pool_size = 64M
innodb_log_file_size = 32M
innodb_log_buffer_size = 8M

# Схема производительности стоит десятки мегабайт и здесь не нужна:
# профилировать нечего, узкое место в фотографиях.
performance_schema = OFF

# Соединений нужно ровно столько, сколько создаёт один Apache с несколькими
# рабочими процессами, плюс запас на разовые команды wp-cli.
max_connections = 25
thread_cache_size = 4

# Буферы на соединение: каждый умножается на число соединений, поэтому
# щедрые значения по умолчанию здесь особенно дороги.
sort_buffer_size = 512K
read_buffer_size = 256K
read_rnd_buffer_size = 256K
join_buffer_size = 512K

# MyISAM в WordPress не используется, кроме внутренних таблиц.
key_buffer_size = 8M

# Временные таблицы держим в памяти до разумного предела, дальше на диск.
tmp_table_size = 16M
max_heap_table_size = 16M

# Дампу нужен полный набор данных статей: длина строки может быть большой.
max_allowed_packet = 64M

# Кодировка — как у WordPress, иначе дамп и восстановление портят символы.
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
